{"nodes": [{"id": "deploy_vps_docker_compose_postgres", "label": "servicio postgres (2 bases via initdb)", "file_type": "code", "source_file": "deploy/vps/docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "initdb scripts only run on the first initialization of the volume, so the two app databases are created once at bootstrap."}, {"id": "deploy_vps_docker_compose_redis", "label": "servicio redis (appendonly yes)", "file_type": "code", "source_file": "deploy/vps/docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "appendonly persistence so queued jobs survive restarts; every producer/consumer reaches it as redis://redis:6379 on the compose network."}, {"id": "deploy_vps_docker_compose_pedido_api", "label": "servicio pedido-api (Express + Prisma 7, :8400)", "file_type": "code", "source_file": "deploy/vps/docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entrypoint runs prisma db push and seeds only when RUN_SEED is true; production sets it false to avoid overwriting real data. JWT secret configuration must stay stable or all sessions are invalidated."}, {"id": "deploy_vps_docker_compose_pedido_front", "label": "servicio pedido-front (Vite \u2192 nginx :5000, VITE_API_BASE_URL=/api)", "file_type": "code", "source_file": "deploy/vps/docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_vps_docker_compose_delivery", "label": "servicio delivery (Next standalone :3000)", "file_type": "code", "source_file": "deploy/vps/docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built with BUILD_STANDALONE=1 and starts with prisma migrate deploy then node server.js; it errors out at boot if the JWT secret is missing because login requires it."}, {"id": "deploy_vps_docker_compose_delivery_sync", "label": "servicio delivery-sync (worker Dockerfile.worker)", "file_type": "code", "source_file": "deploy/vps/docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs its own image because the standalone web image does not ship the worker's dependencies; it gets DELIVERY_URL so it can call the quoting endpoint."}, {"id": "deploy_vps_docker_compose_analitics_api", "label": "servicio analitics-api (FastAPI, alias de red backend)", "file_type": "code", "source_file": "deploy/vps/docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The analitics front's nginx proxies /api/ to the literal host `backend`, so the service declares that network alias; it reads PEDIDO's database directly for analytics."}, {"id": "deploy_vps_docker_compose_analitics_front", "label": "servicio analitics-front (Vite \u2192 nginx :80)", "file_type": "code", "source_file": "deploy/vps/docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "deploy_vps_docker_compose_caddy", "label": "servicio caddy (reverse proxy TLS autom\u00e1tico)", "file_type": "code", "source_file": "deploy/vps/docker-compose.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "deploy_vps_docker_compose_pedido_api", "target": "deploy_vps_docker_compose_postgres", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/vps/docker-compose.yml", "source_location": null, "weight": 1.0}, {"source": "deploy_vps_docker_compose_pedido_api", "target": "deploy_vps_docker_compose_redis", "relation": "shares_data_with", "confiden