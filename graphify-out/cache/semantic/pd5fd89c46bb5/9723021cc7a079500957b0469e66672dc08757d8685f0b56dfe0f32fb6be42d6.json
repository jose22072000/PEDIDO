re": 1.0, "source_file": "deploy/vps/DEPLOY-VPS.md", "source_location": null, "weight": 1.0}, {"source": "deploy_vps_deploy_vps_no_collapse_checklist", "target": "deploy_vps_deploy_vps_import_csv_queue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/vps/DEPLOY-VPS.md", "source_location": null, "weight": 1.0}, {"source": "deploy_vps_deploy_vps_no_collapse_checklist", "target": "deploy_vps_deploy_vps_redis_pubsub_sse", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/vps/DEPLOY-VPS.md", "source_location": null, "weight": 1.0}, {"source": "deploy_vps_deploy_vps_no_collapse_checklist", "target": "deploy_vps_deploy_vps_bounded_concurrency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/vps/DEPLOY-VPS.md", "source_location": null, "weight": 1.0}, {"source": "deploy_vps_deploy_vps_cutover_centralizado", "target": "deploy_vps_deploy_vps_db_restore_queue", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/vps/DEPLOY-VPS.md", "source_location": null, "weight": 1.0}, {"source": "deploy_vps_deploy_vps_cutover_centralizado", "target": "deploy_local_deploy_local_config_json_sucursalid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/vps/DEPLOY-VPS.md", "source_location": null, "weight": 1.0}, {"source": "deploy_vps_deploy_vps_bundle_vs_future_yaml", "target": "deploy_vps_docker_compose_delivery_sync", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/vps/DEPLOY-VPS.md", "source_location": null, "weight": 1.0}, {"source": "deploy_vps_deploy_vps_bundle_vs_future_yaml", "target": "deploy_vps_docker_compose_redis", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/vps/DEPLOY-VPS.md", "source_location": null, "weight": 1.0}, {"source": "deploy_vps_deploy_vps_centralized_model", "target": "deploy_vps_docker_compose_caddy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "deploy/vps/DEPLOY-VPS.md", "source_location": null, "weight": 1.0}, {"source": "deploy_vps_deploy_vps_geo_import_queue", "target": "deploy_local_deploy_local_sucursal_backfill", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "deploy/vps/DEPLOY-VPS.md", "source_location": null, "weight": 1.0}, {"source": "deploy_vps_deploy_vps_domicilios_queue", "target": "handoff_out_queues_deferred", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "deploy/vps/DEPLOY-VPS.md", "source_location": null, "weight": 1.0}], "hyperedges": []}